{
  "extends": [
    "group:allNonMajor",
    "github>powerhome/renovate-config",
    ":semanticCommits"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "description": "Gems don't ship their lockfiles, so bundler updates release nothing",
      "matchManagers": ["bundler"],
      "semanticCommitType": "chore"
    },
    {
      "matchPackageNames": ["rubocop"],
      "allowedVersions": "< 1.45.0"
    }
  ]
}
